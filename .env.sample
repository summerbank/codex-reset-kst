# https://my.telegram.org -> API development tools (사용자 계정 API 정보)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=발급받은_API_HASH
# @BotFather -> /newbot (알림 전용 봇)
BOT_TOKEN=BotFather에서_발급받은_토큰
# @을 포함한 공개 채널 사용자명
SOURCE_CHANNEL=@codex_resets
# 자동 등록: 아래 명령으로 생성한 값을 입력하고 봇에 /start 값 을 보냅니다.
# docker compose run --rm --no-deps monitor python monitor.py --generate-registration-secret
BOT_REGISTRATION_SECRET=
# 선택: 기존 사용자는 개인 채팅의 양의 숫자 ID를 지정할 수 있습니다 (@username 아님).
# 자동 등록을 사용하면 비워 두세요.
BOT_CHAT_ID=
# 선택: 컨테이너에서는 compose.yaml이 /app/data로 지정합니다.
# DATA_DIR=./data
